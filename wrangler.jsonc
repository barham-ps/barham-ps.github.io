{
  "name": "barham-ps-github-io",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/.git/*",
      "/.github/*",
      "/.env*",
      "/database/*",
      "/scripts/*",
      "/supabase/*",
      "/worker/*",
      "/backups/*",
      "/wp-admin/*",
      "/wp-login.php",
      "/security-firewall-check"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "main": "worker/guard.mjs",
  "ratelimits": [
    {
      "name": "ABUSE_LIMIT",
      "namespace_id": "621126",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
